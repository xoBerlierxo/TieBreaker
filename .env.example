# Copy to .env and adjust. Never commit .env (it is in .gitignore).
# The values shown are the defaults the code applies when a variable is unset
# (SPEC §17), except for required values and secrets.
# Comments are on their own lines on purpose: some .env parsers treat an inline
# "# ..." as part of the value.

# --- App -----------------------------------------------------------------------
# development | test | production
APP_ENV=development
HTTP_ADDR=:8080
# Request body limit in bytes (1 MiB).
HTTP_MAX_BODY_BYTES=1048576
# Seconds allowed for in-flight work to finish on shutdown.
SHUTDOWN_GRACE_SECONDS=20

# --- Dependencies (required) ---------------------------------------------------
DATABASE_URL=postgres://tiebreaker:tiebreaker_dev_only@localhost:5432/tiebreaker?sslmode=disable
REDIS_URL=redis://localhost:6379/0
# Used by docker-compose only.
POSTGRES_PASSWORD=tiebreaker_dev_only

# --- Auth (required) -------------------------------------------------------------
# Secret for signing short-lived admin JWTs. Use a long random value, e.g.
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret

# --- LLM (optional; the app works fully without it) ------------------------------
LLM_ENABLED=false
# Required only if LLM_ENABLED=true.
GEMINI_API_KEY=
# There is no default model in code (SPEC §13). Checked on 2026-11-07 against
# https://aistudio.google.com/docs/models : "gemini-3.5-flash-lite" is Stable and
# described as the fastest, most cost-effective 3.5 model.
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=20
LLM_MAX_OUTPUT_TOKENS=1024
# Cap on Gemini calls per UTC day (protects the key's quota); over it, reports
# fall back to the template. Results are cached in Redis by input hash.
LLM_DAILY_MAX_CALLS=500
LLM_CACHE_TTL_HOURS=24
# Do NOT set GOOGLE_API_KEY. The genai SDK prefers it over GEMINI_API_KEY when
# both are set, so the app refuses to start with LLM_ENABLED=true if it is set.

# --- Simulation ------------------------------------------------------------------
SIM_FULL_FUTURES=50000
SIM_QUICK_FUTURES=2000
SIM_CHUNK_SIZE=1000
# 0 means runtime.GOMAXPROCS(0).
SIM_WORKERS=0
SIM_QUICK_TIMEOUT_MS=2000

# --- Interview -------------------------------------------------------------------
INTERVIEW_MAX_QUESTIONS=10
INTERVIEW_STOP_PBEST=0.65
INTERVIEW_MIN_INFO_GAIN=0.02
INTERVIEW_LADDER=0,25000,50000,100000,200000,400000
INTERVIEW_LADDER_CAP=800000

# --- Decision --------------------------------------------------------------------
DECISION_WIN_PBEST=0.55
DECISION_WIN_GAP=0.15
# Nominal yearly opportunity-cost rate (DECISIONS.md D-P-9).
DISCOUNT_RATE=0.07

# --- Jobs ------------------------------------------------------------------------
JOB_LEASE_SECONDS=60
# How often an idle worker polls the queue, and how often a busy worker extends
# its lease and checks for a cancel request.
JOB_POLL_INTERVAL_MS=1000
JOB_HEARTBEAT_MS=1000
# A run whose worker keeps crashing is marked failed after this many attempts.
JOB_MAX_ATTEMPTS=3

# --- Rate limits (Redis) ---------------------------------------------------------
# Simulation starts per session and per client IP, per hour. 0 disables a rule.
RATE_LIMIT_SIM_PER_SESSION_PER_HOUR=10
RATE_LIMIT_SIM_PER_IP_PER_HOUR=30
